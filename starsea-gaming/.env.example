# StarSea Gaming Postgres (independent of Auto-Ontology)
STARSEA_PG_HOST=127.0.0.1
STARSEA_PG_PORT=5433
STARSEA_PG_DB=starsea_gaming
STARSEA_PG_USER=starsea
STARSEA_PG_PASSWORD=starsea_dev_password

# Read-only user for Auto-Ontology datasource connection
STARSEA_READONLY_USER=starsea_readonly
STARSEA_READONLY_PASSWORD=starsea_readonly_password

# Connection URLs
# Admin / seed:
#   postgresql://starsea:starsea_dev_password@127.0.0.1:5433/starsea_gaming
# Auto-Ontology (recommended):
#   postgresql://starsea_readonly:starsea_readonly_password@127.0.0.1:5433/starsea_gaming
